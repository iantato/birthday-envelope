---
import { siteContent } from '../data/siteContent';
import '../styles/reader.css';
import MusicToggle from './MusicToggle.astro';
import MemoryGallery from './MemoryGallery.astro';
import CandleWish from './CandleWish.astro';
import FinalMessage from './FinalMessage.astro';

const { letter } = siteContent;
---

<dialog
  class="letter-reader"
  id="letter-dialog"
  data-letter-dialog
  aria-labelledby="letter-greeting"
  style={{ '--paper': siteContent.envelope.paperColor }}
>
  <header class="reader-toolbar">
    <button class="reader-close" type="button" data-letter-close autofocus>
      {letter.closeLabel}
    </button>
    <MusicToggle />
  </header>
  <article class="reader-letter">
    <h1 id="letter-greeting">{letter.greeting}</h1>
    <div class="reader-paragraphs" data-letter-paragraphs>
      {letter.paragraphs.map((paragraph) => (
        <p>{paragraph.split(/(\*\*.+?\*\*)/g).map((part) =>
          part.startsWith('**') && part.endsWith('**')
            ? <strong>{part.slice(2, -2)}</strong>
            : part
        )}</p>
      ))}
    </div>
    {(letter.signOff || siteContent.senderName) && <footer class="reader-signature">
      {letter.signOff && <p class="reader-sign-off">{letter.signOff}</p>}
      {siteContent.senderName && <p class="reader-sender">{siteContent.senderName}
        <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" focusable="false">
          <path d="M10 16s-7-4.4-7-9a3.5 3.5 0 0 1 7-1 3.5 3.5 0 0 1 7 1c0 4.6-7 9-7 9Z" />
        </svg>
      </p>}
    </footer>}
    <MemoryGallery />
    <CandleWish />
    <FinalMessage />
  </article>
</dialog>
