---
import { siteContent } from '../data/siteContent';
const { candle } = siteContent;
---

<section class="reader-section candle-section" data-candle-section data-candle-state="idle" aria-labelledby="candle-heading">
  <div class="wish-divider" aria-hidden="true">
    <span></span><svg viewBox="0 0 20 20" width="16" height="16" focusable="false"><path d="M10 16s-7-4.4-7-9a3.5 3.5 0 0 1 7-1 3.5 3.5 0 0 1 7 1c0 4.6-7 9-7 9Z" /></svg><span></span>
  </div>
  <h2 id="candle-heading">
    <svg class="wish-heading-rays" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><path d="m19 5 1-4M11 9 7 4M7 17l-6-1" /></svg>
    <span>{candle.prompt}</span>
    <svg class="wish-heading-rays" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><path d="m5 5-1-4m9 8 4-5m0 13 6-1" /></svg>
  </h2>
  <p class="candle-hint" id="candle-hint">{candle.hint}</p>
  <div class="candle-invitation">
    <button class="candle-ready" type="button" data-candle-ready aria-controls="candle-status">
      <svg class="wish-wind-icon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path d="M3 8h12a3 3 0 1 0-3-3M2 12h17a3 3 0 1 1-3 3M4 16h5a2.5 2.5 0 1 1-2.5 2.5" /></svg>
      <span>{candle.readyLabel}</span>
      <svg class="wish-arrow-icon" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false"><path d="M3 10h13m-5-5 5 5-5 5" /></svg>
    </button>
  </div>
  <button class="candle-trigger" type="button" data-candle-trigger data-blown="false" aria-label={candle.buttonLabel} aria-describedby="candle-hint" aria-pressed="false" aria-controls="candle-wish">
    <svg class="birthday-cake" viewBox="0 0 320 250" width="320" height="250" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="cake-sponge" x1="0" y1="0" x2="0.2" y2="1">
          <stop stop-color="#f5d2b3" /><stop offset=".5" stop-color="#f9e2c8" /><stop offset="1" stop-color="#eac09d" />
        </linearGradient>
        <radialGradient id="cake-top" cx=".44" cy=".3" r=".78">
          <stop stop-color="#fffdf6" /><stop offset=".7" stop-color="#fff1e3" /><stop offset="1" stop-color="#f4cfb3" />
        </radialGradient>
        <linearGradient id="cake-icing" x1="0" y1="0" x2="0" y2="1">
          <stop stop-color="#fffcf5" /><stop offset="1" stop-color="#ffead8" />
        </linearGradient>
        <radialGradient id="cake-rose" cx=".36" cy=".24" r=".9">
          <stop stop-color="#ffd7c9" /><stop offset=".55" stop-color="#f2a493" /><stop offset="1" stop-color="#d87974" />
        </radialGradient>
        <linearGradient id="cake-cream" x1="0" y1="0" x2="1" y2="1">
          <stop stop-color="#fffdf5" /><stop offset="1" stop-color="#f1cbb0" />
        </linearGradient>
        <g id="cake-cream-dollop">
          <path d="M-12 4C-15-3-8-7-5-13c3-5 1-8 0-10 11 4 20 15 18 23C11 10-8 12-12 4Z" fill="url(#cake-cream)" />
          <path d="M-5 5c7-4 10-12 4-20M3 7c7-5 9-10 5-15" fill="none" stroke="#e8bea0" stroke-width="1.3" opacity=".65" />
          <path d="M-8 0c0-5 4-7 5-11" fill="none" stroke="#fffdf7" stroke-width="3" stroke-linecap="round" />
        </g>
        <g id="cake-rose-flower">
          <path d="M-21 3c-10-8-5-20 2-22 1-10 14-15 21-11 11-5 22 3 23 13 10 5 12 19 3 25-1 10-15 17-24 10-11 7-25 0-25-15Z" fill="url(#cake-rose)" />
          <path d="M-16 4c-7-13 2-27 15-25 15-9 29 6 23 20-2 15-23 18-28 6-8-3-12-13-4-19 7-10 22-4 20 5 2 8-10 13-14 5-3-7 6-12 10-6" fill="none" stroke="#cf7b76" stroke-width="2.2" stroke-linecap="round" />
          <path d="M-18-4c-5-8-1-15 6-19m9-5c9-4 18 1 20 9m9 8c4 8-1 17-8 20M-12 17c-8 2-14-4-15-10" fill="none" stroke="#ffe2d2" stroke-width="3.8" stroke-linecap="round" />
        </g>
      </defs>
      <ellipse cx="160" cy="235" rx="139" ry="12" fill="#c99179" opacity=".12" />
      <ellipse cx="160" cy="230" rx="145" ry="14" fill="#fff4e9" />
      <path d="M34 161v57c0 22 251 27 252-1v-56Z" fill="url(#cake-sponge)" />
      <path d="M35 195c51 19 194 22 250 0v12c-58 20-196 20-250-1Z" fill="#fff4e6" opacity=".85" />
      <path d="M35 218c55 22 197 23 250-1" fill="none" stroke="#dcad8b" stroke-width="2" opacity=".55" />
      <ellipse cx="160" cy="161" rx="127" ry="42" fill="url(#cake-top)" />
      <path d="M33 162c0 13 17 22 24 24 4 1 4 15 15 15 10 0 11-10 18-8 13 4 13 18 27 18 12 0 12-13 23-12 14 1 15 16 29 15 12-1 10-16 23-16 10 0 12 14 23 12 13-2 9-17 22-19 10-2 13 10 23 5 8-4 4-14 13-19 9-5 14-9 14-16-30 42-220 44-254 1Z" fill="url(#cake-icing)" />
      <ellipse cx="160" cy="158" rx="115" ry="32" fill="none" stroke="#fffdf8" stroke-width="2" opacity=".8" />
      <g opacity=".6" fill="none" stroke="#dc9185" stroke-width="2.3" stroke-linecap="round">
        <path d="m60 159 7 2m10 13 6-2m13-20 5 3m20 19 6 2m10-31 5 2m4 37 6-2m20-10 5 3m15-28 5-2m8 30 6-1m22-14 5 1m-5 14 4 2m19-17 5 1" />
      </g>
      <use href="#cake-cream-dollop" transform="translate(62 150) rotate(-14) scale(.83)" />
      <use href="#cake-cream-dollop" transform="translate(119 136) rotate(-8) scale(.76)" />
      <use href="#cake-cream-dollop" transform="translate(202 135) rotate(12) scale(.78)" />
      <use href="#cake-cream-dollop" transform="translate(257 154) rotate(15) scale(.85)" />
      <use href="#cake-rose-flower" transform="translate(90 145) rotate(-20) scale(.78)" />
      <use href="#cake-rose-flower" transform="translate(229 146) rotate(18) scale(.8)" />
      <use href="#cake-cream-dollop" transform="translate(143 169) rotate(-6) scale(.62)" />
      <use href="#cake-cream-dollop" transform="translate(184 169) rotate(12) scale(.61)" />
    </svg>
    <span class="candle-flame" aria-hidden="true"><span class="candle-flame-core"></span></span>
    <svg class="candle-smoke" viewBox="0 0 24 64" width="24" height="64" aria-hidden="true" focusable="false">
      <path d="M12 62 C4 51 22 43 13 32 S5 15 14 3" />
    </svg>
    <span class="candle-wick" aria-hidden="true"></span>
    <span class="candle-wax" aria-hidden="true"></span>
  </button>
  <div class="candle-actions">
    <button class="text-control" type="button" data-candle-fallback aria-controls="candle-wish">{candle.fallbackLabel}</button>
    <button class="text-control" type="button" data-candle-cancel hidden>{candle.cancelLabel}</button>
  </div>
  <p class="candle-status" id="candle-status" data-candle-status role="status" aria-atomic="true"></p>
  <div class="candle-wish-slot">
    <p class="candle-wish-space" aria-hidden="true">{candle.revealedWish}</p>
    <p class="candle-wish" id="candle-wish" data-candle-wish data-wish={candle.revealedWish} aria-live="polite" aria-atomic="true"></p>
  </div>
</section>
