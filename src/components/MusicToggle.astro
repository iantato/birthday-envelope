---
import { siteContent } from '../data/siteContent';
const { song } = siteContent;
---

{song.src.trim() && (
  <div class="music-control">
    <audio data-audio src={song.src} preload="none" aria-label={song.title}></audio>
    <button
      class="text-control music-toggle"
      type="button"
      data-music-toggle
      data-play-label={song.playLabel}
      data-pause-label={song.pauseLabel}
      data-error-message={song.errorMessage}
      aria-label={song.playLabel}
      aria-pressed="false"
      aria-describedby="music-status"
    >{song.playLabel}</button>
    <span class="music-status" id="music-status" data-music-status role="status"></span>
  </div>
)}
