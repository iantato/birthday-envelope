---
import { siteContent } from '../data/siteContent';
---

<section class="reader-section final-section" aria-labelledby="final-heading">
  <h2 id="final-heading">{siteContent.finalHeading}</h2>
  <p>{siteContent.finalMessage}</p>
  <button class="text-control" type="button" data-replay>{siteContent.replayLabel}<span aria-hidden="true"> &#8634;</span></button>
</section>
