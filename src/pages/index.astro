---
import { siteContent } from '../data/siteContent';
import EnvelopeScene from '../components/EnvelopeScene.astro';
import LetterReader from '../components/LetterReader.astro';
import '../styles/global.css';
---

<html lang={siteContent.language} style={siteContent.theme}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500&display=swap" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={siteContent.description} />
		<meta name="robots" content="noindex,nofollow" />
		<title>{siteContent.pageTitle}</title>
	</head>
	<body>
		<main>
			<EnvelopeScene />
			<LetterReader />
		</main>
		<script>
			import '../scripts/experience';
		</script>
	</body>
</html>
